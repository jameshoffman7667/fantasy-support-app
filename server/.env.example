# Copy this file to .env (same folder) and fill in your real key.
# .env is already in .gitignore — never commit it, never paste your real
# key into chat with an AI assistant, and never put it in client-side code.

FANTASYPROS_API_KEY=your_key_here

# Required for login (v2.1): the owner's Sleeper username and first password
# (changed at first login). See the root .env.example / README for more.
OWNER_USERNAME=your_sleeper_username
OWNER_PASSWORD=change_me_8_chars_min
# OWNER_FORCE_RESET=true   # recovery only, one restart
# DB_JOURNAL_MODE=         # WAL | WAL_EXCLUSIVE | DELETE (normally unset)

# Optional overrides
PORT=4000
FANTASYPROS_BASE_URL=https://api.fantasypros.com/public/v2/json

# Web Push (v2) — powers pre-kickoff alerts (starter ruled Out/IR/PUP, or a
# bench option clearly outscoring a starter). Without these three set, the
# server still runs fine — push alerts are just disabled (see startup
# warning in the logs). Generate a keypair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any mailto: link or URL identifying you, as required by the Web Push
# protocol (RFC 8292) — not sent to you, just required by push services.
VAPID_SUBJECT=mailto:you@example.com

# v4.0 (optional): Android app (ANDROID_APK.md). The signing key's SHA-256 fingerprint, as
# printed by the "Build Android app" workflow, and the package name if you changed it.
ANDROID_APP_SHA256=
ANDROID_APP_PACKAGE=

# v2.4 — Tank01 NFL API key from RapidAPI (optional). Enables Vegas
# prop-based projections and Tank01 projections; without it the app uses
# Sleeper, then ESPN. Free tier is 1,000 calls/month; the app budgets
# ~450-500 and stops TANK01_RESERVE calls short of TANK01_MONTHLY_LIMIT.
TANK01_API_KEY=
# TANK01_MONTHLY_LIMIT=1000
# TANK01_RESERVE=50

# v2.7 — Gemini for the Pick'em upset-article scan (optional). Free key from
# Google AI Studio. GEMINI_MODEL defaults to gemini-3.5-flash-lite.
GEMINI_API_KEY=
# GEMINI_MODEL=

# v3.0 (optional): long random string used to encrypt a stored Sleeper token.
# If unset, a key is generated and stored in the same database as the token (weaker).
SESSION_SECRET=
