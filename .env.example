# Only needed if running `docker compose up` locally instead of through
# Portainer. Copy this file to ".env" (same folder as docker-compose.yml)
# and fill in your real values. If you're deploying via Portainer, skip
# this file entirely and enter these as Environment variables in
# Portainer's UI instead — see README.

FANTASYPROS_API_KEY=your_key_here

# Required for login (v2.1). People log in with their Sleeper username + a
# password. OWNER_USERNAME is the owner's Sleeper username; the owner account
# is created at first start with OWNER_PASSWORD and you're made to change it
# at first login. The owner then adds guests/owners and manages passwords and
# access inside the app. Replaces the old APP_PASSWORD (no longer read).
# Leaving these unset means nobody can log in (fails closed).
OWNER_USERNAME=your_sleeper_username
OWNER_PASSWORD=change_me_8_chars_min

# Recovery only: uncomment for ONE restart to reset the owner's password to
# OWNER_PASSWORD (then remove it, or it repeats on every restart).
# OWNER_FORCE_RESET=true

# Optional: WAL | WAL_EXCLUSIVE | DELETE. Normally unset — the server falls
# back automatically if the data volume can't do SQLite WAL.
# DB_JOURNAL_MODE=

# Whoever published the images (see .github/workflows/docker-publish.yml
# and the README's "Publishing images to Docker Hub" section). Defaults
# to mybadreligon's own published images if unset — only change this if
# you've forked the project and published your own images instead.
DOCKERHUB_USER=mybadreligon

# Optional — pin to a specific build instead of always pulling :latest,
# e.g. a git-sha tag or a version tag like v1.2.3.
IMAGE_TAG=latest

# Optional — change which host ports the stack publishes on.
SERVER_PORT=4000
CLIENT_PORT=5000

# Web Push (v2) — powers pre-kickoff alerts. Optional: leave blank to run
# without push alerts. Generate a keypair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# v4.0 (optional): Android app (ANDROID_APK.md). The signing key's SHA-256 fingerprint, as
# printed by the "Build Android app" workflow, and the package name if you changed it.
ANDROID_APP_SHA256=
ANDROID_APP_PACKAGE=

# v2.4 — Tank01 NFL API key from RapidAPI (optional). Enables Vegas
# prop-based projections and Tank01 projections; without it the app uses
# Sleeper, then ESPN. Free tier is 1,000 calls/month; the app budgets
# ~450-500 and stops TANK01_RESERVE calls short of TANK01_MONTHLY_LIMIT.
TANK01_API_KEY=
# TANK01_MONTHLY_LIMIT=1000
# TANK01_RESERVE=50

# v2.7 — Gemini for the Pick'em upset-article scan (optional). Free key from
# Google AI Studio. GEMINI_MODEL defaults to gemini-3.5-flash-lite.
GEMINI_API_KEY=
# GEMINI_MODEL=
